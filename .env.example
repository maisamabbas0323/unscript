# Unscript configuration.
# Copy this file to `.env` and adjust values. Never commit a real `.env`.

# Debug mode: show full error details and stack traces in the CLI.
# Accepted values: true / false / 1 / 0 (also: yes / no, on / off).
UNSCRIPT_DEBUG=false

# Standard NO_COLOR flag: set to any value to disable terminal colors.
# NO_COLOR=

# --- Runtime (Step 5: knowledge + transformation) ----------------------------
# The transformation flow needs all three variables. `unscript knowledge`
# needs only the Context MCP pair. `unscript doctor` reports what is missing.

# Full URL of a hosted Sanity Context MCP endpoint (GROQ mode):
#   https://api.sanity.io/v1/context/organizations/<org-id>/mcp/<endpoint-name>
# Create the endpoint in the Sanity Context app (Dashboard → Context → MCPs),
# with a dataset source and GROQ mode.
SANITY_CONTEXT_MCP_URL=

# Organization API token with Context Viewer permission
# (grant: sanity.knowledge-base.read). Create it in
# https://www.sanity.io/manage/organization/<org-id>/api
SANITY_ORGANIZATION_TOKEN=

# Google AI Studio API key for the Gemini transformation model
# (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
